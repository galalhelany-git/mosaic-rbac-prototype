{
  "name": "@mosaic-ds/react",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral React implementation of the Mosaic Design System.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "dependencies": {
    "@mosaic-ds/tokens": "workspace:*",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "scripts": {
    "build": "tsup && esbuild src/styles/index.css --bundle --outfile=dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
