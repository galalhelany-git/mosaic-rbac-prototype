{
  "name": "mosaic-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mosaic design tokens, React components, documentation, and Storybook.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @mosaic-ds/storybook build",
    "build:packages": "pnpm --filter @mosaic-ds/tokens build && pnpm --filter @mosaic-ds/react build",
    "build:roles": "pnpm --filter @mosaic-ds/tokens build && pnpm --filter @mosaic-ds/react build && pnpm --filter @mosaic-ds/roles-app build",
    "storybook": "pnpm --filter @mosaic-ds/storybook dev",
    "storybook:build": "pnpm --filter @mosaic-ds/storybook build",
    "tokens:generate": "pnpm --filter @mosaic-ds/tokens generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "esbuild": "0.28.2",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
